local function MkFrame(par, sz, pos, col, zi)
    local f = Instance.new("Frame")
    f.Size=sz; f.Position=pos; f.BackgroundColor3=col or C.PANEL
    f.BorderSizePixel=0; f.ZIndex=zi or 2; f.Parent=par
    return f
end
local function MkLabel(par, txt, sz, pos, col, fs, xa, zi)
    local l = Instance.new("TextLabel")
    l.Text=txt; l.Size=sz; l.Position=pos
    l.TextColor3=col or C.TEXT; l.Font=Enum.Font.GothamBold
    l.TextSize=fs or 13
    l.TextXAlignment=xa or Enum.TextXAlignment.Left
    l.BackgroundTransparency=1; l.ZIndex=zi or 3; l.Parent=par
    return l
end
local function MkCorner(p,r)
    local c=Instance.new("UICorner"); c.CornerRadius=UDim.new(0,r or 6); c.Parent=p
end
local function MkStroke(p,col,th)
    local s=Instance.new("UIStroke"); s.Color=col or C.BORDER; s.Thickness=th or 1; s.Parent=p
end
local function MkBtn(par, txt, sz, pos, bg, tc, fs, zi)
    local b=Instance.new("TextButton")
    b.Text=txt; b.Size=sz; b.Position=pos
    b.BackgroundColor3=bg or C.SLBG; b.TextColor3=tc or C.TEXT
    b.Font=Enum.Font.GothamBold; b.TextSize=fs or 13
    b.BorderSizePixel=0; b.AutoButtonColor=false
    b.ZIndex=zi or 5; b.Parent=par
    return b
end

