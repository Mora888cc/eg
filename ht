}

-- ESP cache
local ESPCache = {}
local BONES = {
    {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
    {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},
    {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},
    {"LowerTorso","LeftUpperLeg"},{"LowerTorso","RightUpperLeg"},
}

local function GetESP(plr)
    if not ESPCache[plr] then
        local e = {
            box = {
                NewDraw("Line",{Color=Color3.new(1,0,0),Thickness=1,Visible=false}),
                NewDraw("Line",{Color=Color3.new(1,0,0),Thickness=1,Visible=false}),
                NewDraw("Line",{Color=Color3.new(1,0,0),Thickness=1,Visible=false}),
                NewDraw("Line",{Color=Color3.new(1,0,0),Thickness=1,Visible=false}),
            },
            name   = NewDraw("Text",{Size=14,Font=2,Color=Color3.new(1,1,1),Outline=true,Visible=false,Text=""}),
            hp     = NewDraw("Text",{Size=12,Font=2,Color=C.GREEN,Outline=true,Visible=false,Text=""}),
            dist   = NewDraw("Text",{Size=11,Font=2,Color=Color3.fromRGB(180,180,200),Outline=true,Visible=false,Text=""}),
            tracer = NewDraw("Line",{Color=Color3.fromRGB(255,255,100),Thickness=1,Visible=false}),
            bones  = {},
        }
        for _=1,#BONES do
            table.insert(e.bones, NewDraw("Line",{Color=Color3.fromRGB(255,200,60),Thickness=1,Visible=false}))
        end
        ESPCache[plr] = e
    end
    return ESPCache[plr]
end

Players.PlayerRemoving:Connect(function(plr)
    if ESPCache[plr] then
        for _,l in ipairs(ESPCache[plr].box)   do pcall(function() l:Remove() end) end
        for _,l in ipairs(ESPCache[plr].bones) do pcall(function() l:Remove() end) end
        pcall(function() ESPCache[plr].name:Remove() end)
        pcall(function() ESPCache[plr].hp:Remove() end)
        pcall(function() ESPCache[plr].dist:Remove() end)
        pcall(function() ESPCache[plr].tracer:Remove() end)
        ESPCache[plr] = nil
    end
end)

-- Chams
local ChamCache = {}
local function UpdateChams()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local char = plr.Character
        if not char then
            if ChamCache[plr] then pcall(function() ChamCache[plr]:Destroy() end); ChamCache[plr]=nil end
            continue
        end
        if CFG.V_Chams or CFG.V_Highlight then
            if not ChamCache[plr] then
                local hl = Instance.new("SelectionBox")
                hl.Adornee           = char
                hl.Color3            = CFG.V_ChamColor
                hl.LineThickness     = 0.05
                hl.SurfaceTransparency = CFG.V_Highlight and 0.5 or 1
                hl.SurfaceColor3     = CFG.V_ChamColor
                hl.Parent            = workspace
                ChamCache[plr]       = hl
            else
                ChamCache[plr].Color3             = CFG.V_ChamColor
                ChamCache[plr].SurfaceColor3      = CFG.V_ChamColor
                ChamCache[plr].SurfaceTransparency= CFG.V_Highlight and 0.5 or 1
            end
        else
            if ChamCache[plr] then pcall(function() ChamCache[plr]:Destroy() end); ChamCache[plr]=nil end
        end
    end
end

-- Silent Aim target
local function GetTarget()
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local best, bestScore = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr==LP then continue end
        if CFG.SA_TeamChk and plr.Team==LP.Team then continue end
        local char = plr.Character
        if not char then continue end
        local part = char:FindFirstChild(CFG.SA_Part=="Random" and ({"Head","UpperTorso"})[math.random(2)] or CFG.SA_Part)
        if not part then continue end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health<=0 then continue end
        local sp, on = Camera:WorldToViewportPoint(part.Position)
        if not on then continue end
        local sc = Vector2.new(sp.X,sp.Y)
        local d  = (sc-center).Magnitude
        if d>CFG.SA_FOVSize then continue end
        if CFG.SA_WallChk then
            local ray = Ray.new(Camera.CFrame.Position, (part.Position-Camera.CFrame.Position))
            local hit = workspace:FindPartOnRayWithIgnoreList(ray,{LP.Character,Camera})
            if hit then continue end
        end
        local score = CFG.SA_Target=="LowestHP" and hum.Health
                   or CFG.SA_Target=="HighestHP" and -hum.Health
                   or d
        if score<bestScore then bestScore=score; best={part=part,plr=plr} end
    end
    return best
end

-- Anti Aim
local spinA = 0
local function DoAntiAim()
    if not CFG.AA_Enabled then return end
    local char = LP.Character; if not char then return end
    local hrp  = char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local pitch,yaw = 0,0
    if CFG.AA_Pitch=="Down" then pitch=-89 elseif CFG.AA_Pitch=="Up" then pitch=89 end
    if CFG.AA_Yaw=="Backwards" then yaw=180 elseif CFG.AA_Yaw=="Sideways" then yaw=90 end
    if CFG.AA_Spin then spinA=(spinA+8)%360; yaw=spinA end
    if CFG.AA_Jitter then yaw=yaw+math.random(-20,20) end
    if CFG.AA_Random then pitch=math.random(-89,89); yaw=math.random(0,360) end
    pcall(function()
        hrp.CFrame = CFrame.new(hrp.Position)
            * CFrame.Angles(0,math.rad(yaw),0)
            * CFrame.Angles(math.rad(pitch),0,0)
    end)
end

