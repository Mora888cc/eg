local function Toggle(page, lbl, key, cb)
    local row = MkFrame(page, UDim2.new(1,-4,0,30), UDim2.new(0,0,0,0), C.PANEL, 5)
    MkCorner(row, 6)
    MkLabel(row, lbl, UDim2.new(1,-52,1,0), UDim2.new(0,10,0,0), C.TEXT, 12, Enum.TextXAlignment.Left, 6)

    local on = CFG[key]
    local track = MkFrame(row, UDim2.new(0,36,0,18), UDim2.new(1,-44,0.5,-9), on and C.TON or C.TOFF, 6)
    MkCorner(track,9)
    local knob = MkFrame(track, UDim2.new(0,14,0,14), UDim2.new(0,on and 19 or 3,0.5,-7), Color3.new(1,1,1), 7)
    MkCorner(knob,7)

    local hit = Instance.new("TextButton")
    hit.Size=UDim2.new(1,0,1,0); hit.Position=UDim2.new(0,0,0,0)
    hit.BackgroundTransparency=1; hit.Text=""; hit.ZIndex=8; hit.Parent=row
    hit.MouseButton1Click:Connect(function()
        CFG[key] = not CFG[key]
        local v = CFG[key]
        TweenService:Create(track,TweenInfo.new(0.13),{BackgroundColor3=v and C.TON or C.TOFF}):Play()
        TweenService:Create(knob, TweenInfo.new(0.13),{Position=UDim2.new(0,v and 19 or 3,0.5,-7)}):Play()
        if cb then pcall(cb,v) end
    end)
end

local function Slider(page, lbl, key, mn, mx, fmt, cb)
    fmt = fmt or "%.0f"
    local row = MkFrame(page, UDim2.new(1,-4,0,46), UDim2.new(0,0,0,0), C.PANEL, 5)
    MkCorner(row,6)
    MkLabel(row, lbl, UDim2.new(0.62,0,0,18), UDim2.new(0,10,0,4), C.TEXT, 12, Enum.TextXAlignment.Left, 6)
    local vl = MkLabel(row, string.format(fmt,CFG[key]), UDim2.new(0.34,0,0,18), UDim2.new(0.62,0,0,4), C.SUB, 11, Enum.TextXAlignment.Right, 6)

    local tr = MkFrame(row, UDim2.new(1,-18,0,5), UDim2.new(0,9,0,33), C.SLBG, 6)
    MkCorner(tr,3)
    local pct = math.clamp((CFG[key]-mn)/(mx-mn),0,1)
    local fl  = MkFrame(tr, UDim2.new(pct,0,1,0), UDim2.new(0,0,0,0), C.ACCENT, 7); MkCorner(fl,3)
    local th  = MkFrame(tr, UDim2.new(0,12,0,12), UDim2.new(pct,0,0.5,-6), C.ACCENT2, 8); MkCorner(th,6)

    local sl = false
    local function upd(inp)
        local ax = tr.AbsolutePosition.X
        local aw = tr.AbsoluteSize.X
        local p  = math.clamp((inp.Position.X - ax)/aw, 0, 1)
        local v  = mn + (mx-mn)*p
        CFG[key] = v
        vl.Text  = string.format(fmt,v)
        fl.Size  = UDim2.new(p,0,1,0)
        th.Position = UDim2.new(p,0,0.5,-6)
        if cb then pcall(cb,v) end
    end
    tr.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then sl=true; upd(i) end
    end)
    UserInputService.InputChanged:Connect(function(i)
        if sl and i.UserInputType==Enum.UserInputType.MouseMovement then upd(i) end
    end)
    UserInputService.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then sl=false end
    end)
end

local function Dropdown(page, lbl, key, opts, cb)
    local row = MkFrame(page, UDim2.new(1,-4,0,30), UDim2.new(0,0,0,0), C.PANEL, 5)
    MkCorner(row,6)
    MkLabel(row, lbl, UDim2.new(0.52,0,1,0), UDim2.new(0,10,0,0), C.TEXT, 12, Enum.TextXAlignment.Left, 6)

    local dd = MkBtn(row, CFG[key], UDim2.new(0,138,0,22), UDim2.new(1,-145,0.5,-11), C.SLBG, C.TEXT, 11, 7)
    MkCorner(dd,5); MkStroke(dd,C.BORDER,1)
    MkLabel(dd,"▾",UDim2.new(0,16,1,0),UDim2.new(1,-18,0,0),C.ACCENT,12,Enum.TextXAlignment.Left,8)

    local pop = MkFrame(ScreenGui,
        UDim2.new(0,138,0,#opts*26+6),
        UDim2.new(0,0,0,0), C.PANEL, 25)
    MkCorner(pop,6); MkStroke(pop,C.BORDER,1)
    pop.Visible=false

    local pul = Instance.new("UIListLayout"); pul.SortOrder=Enum.SortOrder.LayoutOrder
    pul.Padding=UDim.new(0,2); pul.Parent=pop
    local pp = Instance.new("UIPadding"); pp.PaddingTop=UDim.new(0,3)
    pp.PaddingLeft=UDim.new(0,3); pp.PaddingRight=UDim.new(0,3); pp.Parent=pop

    for _, opt in ipairs(opts) do
        local ob = MkBtn(pop, opt, UDim2.new(1,0,0,24), UDim2.new(0,0,0,0),
            opt==CFG[key] and C.ACCENT or C.SLBG, C.TEXT, 11, 26)
        MkCorner(ob,4)
        ob.MouseButton1Click:Connect(function()
            CFG[key]=opt; dd.Text=opt; pop.Visible=false
            for _,b in ipairs(pop:GetChildren()) do
                if b:IsA("TextButton") then
                    b.BackgroundColor3 = b.Text==opt and C.ACCENT or C.SLBG
                end
            end
            if cb then pcall(cb,opt) end
        end)
    end

    local open=false
    dd.MouseButton1Click:Connect(function()
        open=not open
        if open then
            local ap = dd.AbsolutePosition
            local as = dd.AbsoluteSize
            pop.Position=UDim2.new(0,ap.X,0,ap.Y+as.Y+2)
        end
        pop.Visible=open
    end)
    UserInputService.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 and open then
            local mp = UserInputService:GetMouseLocation()
            local ap = pop.AbsolutePosition; local as = pop.AbsoluteSize
            if mp.X<ap.X or mp.X>ap.X+as.X or mp.Y<ap.Y or mp.Y>ap.Y+as.Y then
                open=false; pop.Visible=false
            end
        end
    end)
end

local function ColorPicker(page, lbl, key, cb)
    local row = MkFrame(page, UDim2.new(1,-4,0,30), UDim2.new(0,0,0,0), C.PANEL, 5)
    MkCorner(row,6)
    MkLabel(row, lbl, UDim2.new(0.6,0,1,0), UDim2.new(0,10,0,0), C.TEXT, 12, Enum.TextXAlignment.Left, 6)

    local sw = MkFrame(row, UDim2.new(0,22,0,22), UDim2.new(1,-30,0.5,-11), CFG[key], 6)
    MkCorner(sw,5); MkStroke(sw,C.BORDER,1)

    local pop = MkFrame(ScreenGui, UDim2.new(0,210,0,155), UDim2.new(0,0,0,0), C.PANEL, 30)
    MkCorner(pop,8); MkStroke(pop,C.BORDER,1)
    pop.Visible=false

    local ch = {
        {lbl="R", col=Color3.fromRGB(220,60,60)},
        {lbl="G", col=Color3.fromRGB(60,200,100)},
        {lbl="B", col=Color3.fromRGB(60,140,220)},
    }
    local vals = {CFG[key].R, CFG[key].G, CFG[key].B}

    local function Rebuild()
        CFG[key] = Color3.new(vals[1],vals[2],vals[3])
        sw.BackgroundColor3 = CFG[key]
        if cb then pcall(cb, CFG[key]) end
    end

    for ci, info in ipairs(ch) do
        local y0 = (ci-1)*48 + 8
        MkLabel(pop, info.lbl, UDim2.new(0,14,0,16), UDim2.new(0,8,0,y0), C.TEXT, 12, Enum.TextXAlignment.Left, 31)
        local tr2 = MkFrame(pop, UDim2.new(1,-54,0,5), UDim2.new(0,26,0,y0+18), C.SLBG, 31)
        MkCorner(tr2,3)
        local fl2 = MkFrame(tr2, UDim2.new(vals[ci],0,1,0), UDim2.new(0,0,0,0), info.col, 32); MkCorner(fl2,3)
        local th2 = MkFrame(tr2, UDim2.new(0,10,0,10), UDim2.new(vals[ci],0,0.5,-5), Color3.new(1,1,1), 33); MkCorner(th2,5)
        local vl2 = MkLabel(pop, math.floor(vals[ci]*255).."", UDim2.new(0,28,0,16), UDim2.new(1,-36,0,y0), C.SUB, 11, Enum.TextXAlignment.Right, 31)

        local sl2=false
        local function upd2(inp)
            local ax=tr2.AbsolutePosition.X; local aw=tr2.AbsoluteSize.X
            local p=math.clamp((inp.Position.X-ax)/aw,0,1)
            vals[ci]=p
            fl2.Size=UDim2.new(p,0,1,0)
            th2.Position=UDim2.new(p,0,0.5,-5)
            vl2.Text=math.floor(p*255)..""
            Rebuild()
        end
        tr2.InputBegan:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1 then sl2=true; upd2(i) end
        end)
        UserInputService.InputChanged:Connect(function(i)
            if sl2 and i.UserInputType==Enum.UserInputType.MouseMovement then upd2(i) end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.MouseButton1 then sl2=false end
        end)
    end

    local popOpen=false
    local swHit = Instance.new("TextButton")
    swHit.Size=UDim2.new(1,0,1,0); swHit.BackgroundTransparency=1
    swHit.Text=""; swHit.ZIndex=9; swHit.Parent=sw
    swHit.MouseButton1Click:Connect(function()
        popOpen=not popOpen
        if popOpen then
            local ap=sw.AbsolutePosition; local as=sw.AbsoluteSize
            pop.Position=UDim2.new(0,ap.X-180,0,ap.Y+as.Y+4)
        end
        pop.Visible=popOpen
    end)
    UserInputService.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 and popOpen then
            local mp=UserInputService:GetMouseLocation()
            local ap=pop.AbsolutePosition; local as=pop.AbsoluteSize
            if mp.X<ap.X or mp.X>ap.X+as.X or mp.Y<ap.Y or mp.Y>ap.Y+as.Y then
                popOpen=false; pop.Visible=false
            end
        end
    end)
end

