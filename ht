--  RENDER LOOP
-- ══════════════════════════════════════════════════════════════
local frame=0
RunService.RenderStepped:Connect(function()
    frame=frame+1
    local vp  = Camera.ViewportSize
    local cx,cy = vp.X/2, vp.Y/2

    -- FOV
    pcall(function()
        FovCircle.Visible  = CFG.SA_Enabled and CFG.SA_ShowFOV
        FovCircle.Radius   = CFG.SA_FOVSize
        FovCircle.Position = Vector2.new(cx,cy)
    end)

    -- Crosshair
    local cs=10
    pcall(function()
        CHLines[1].Visible=CFG.V_Crosshair; CHLines[2].Visible=CFG.V_Crosshair
        if CFG.V_Crosshair then
            CHLines[1].Color=CFG.V_CrossColor; CHLines[2].Color=CFG.V_CrossColor
            CHLines[1].From=Vector2.new(cx-cs,cy); CHLines[1].To=Vector2.new(cx+cs,cy)
            CHLines[2].From=Vector2.new(cx,cy-cs); CHLines[2].To=Vector2.new(cx,cy+cs)
        end
    end)

    -- Silent Aim
    if CFG.SA_Enabled then
        pcall(function()
            local t=GetTarget()
            if t and math.random(100)<=CFG.SA_HitChance then
                local sp=Camera:WorldToViewportPoint(t.part.Position)
                local sm=CFG.SA_Smooth
                mousemoverel((sp.X-cx)/sm,(sp.Y-cy)/sm)
            end
        end)
    end

    -- Anti Aim (every 2 frames)
    if frame%2==0 then pcall(DoAntiAim) end

    -- Time
    if CFG.W_TimeChanger then
        pcall(function() Lighting.ClockTime=CFG.W_ClockTime end)
    end

    -- Third Person
    if CFG.V_ThirdPerson then
        pcall(function()
            local char=LP.Character
            if char then
                local hrp=char:FindFirstChild("HumanoidRootPart")
                if hrp then Camera.CFrame=hrp.CFrame*CFrame.new(2,2,8) end
            end
        end)
    end

    -- Chams every 12 frames
    if frame%12==0 then pcall(UpdateChams) end

    -- ESP
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr==LP then continue end
        local e   = GetESP(plr)
        local show= false
        pcall(function()
            local char=plr.Character; if not char then return end
            if not CFG.ESP_Enabled then return end
            if CFG.ESP_TeamChk and plr.Team==LP.Team then return end
            local root=char:FindFirstChild("HumanoidRootPart"); if not root then return end
            local dist=(Camera.CFrame.Position-root.Position).Magnitude
            if dist>CFG.ESP_MaxDist then return end
            local rsp, on = Camera:WorldToViewportPoint(root.Position)
            if not on then return end

            local head=char:FindFirstChild("Head")
            local hPos=head and head.Position or root.Position+Vector3.new(0,1.5,0)
            local fPos=root.Position-Vector3.new(0,3,0)
            local hsp = Camera:WorldToViewportPoint(hPos)
            local fsp = Camera:WorldToViewportPoint(fPos)

            local top   =math.min(hsp.Y,fsp.Y)
            local bottom=math.max(hsp.Y,fsp.Y)
            local h     =bottom-top
            local w     =h*0.55
            local lx    =rsp.X-w/2
            local rx    =rsp.X+w/2

            show=true

            -- Box
            local bColor=plr.Team==LP.Team and C.GREEN or C.RED
            if CFG.ESP_Box then
                local corners={
                    {Vector2.new(lx,top),    Vector2.new(rx,top)},
                    {Vector2.new(rx,top),    Vector2.new(rx,bottom)},
                    {Vector2.new(rx,bottom), Vector2.new(lx,bottom)},
                    {Vector2.new(lx,bottom), Vector2.new(lx,top)},
                }
                for i,ln in ipairs(e.box) do
                    ln.Visible=true; ln.From=corners[i][1]; ln.To=corners[i][2]; ln.Color=bColor
                end
            else for _,ln in ipairs(e.box) do ln.Visible=false end end

            -- Name
            if CFG.ESP_Name then
                e.name.Visible=true; e.name.Text=plr.Name
                e.name.Position=Vector2.new(rsp.X, top-16)
            else e.name.Visible=false end

            -- HP
            local hum=char:FindFirstChildOfClass("Humanoid")
            if CFG.ESP_Health and hum then
                local hp,mhp=hum.Health,hum.MaxHealth
                e.hp.Visible=true
                e.hp.Text=math.floor(hp).."/"..math.floor(mhp)
                e.hp.Position=Vector2.new(lx-2,top)
                e.hp.Color=Color3.new(1-hp/mhp, hp/mhp, 0.2)
            else e.hp.Visible=false end

            -- Distance
            if CFG.ESP_Dist then
                e.dist.Visible=true
                e.dist.Text=math.floor(dist).."m"
                e.dist.Position=Vector2.new(rsp.X, bottom+2)
            else e.dist.Visible=false end

            -- Tracer
            if CFG.ESP_Tracers then
                e.tracer.Visible=true
                e.tracer.From=Vector2.new(cx,vp.Y)
                e.tracer.To  =Vector2.new(rsp.X,bottom)
            else e.tracer.Visible=false end

            -- Skeleton
            if CFG.ESP_Skeleton then
                for bi,bp in ipairs(BONES) do
                    local pa=char:FindFirstChild(bp[1])
                    local pb=char:FindFirstChild(bp[2])
                    if pa and pb and e.bones[bi] then
                        local sa=Camera:WorldToViewportPoint(pa.Position)
                        local sb=Camera:WorldToViewportPoint(pb.Position)
                        e.bones[bi].Visible=true
                        e.bones[bi].From=Vector2.new(sa.X,sa.Y)
                        e.bones[bi].To  =Vector2.new(sb.X,sb.Y)
                    elseif e.bones[bi] then e.bones[bi].Visible=false end
                end
            else for _,b in ipairs(e.bones) do b.Visible=false end end
        end)

        if not show then
            pcall(function()
                for _,ln in ipairs(e.box)   do ln.Visible=false end
                for _,ln in ipairs(e.bones) do ln.Visible=false end
                e.name.Visible=false; e.hp.Visible=false
                e.dist.Visible=false; e.tracer.Visible=false
            end)
        end
    end
end)

